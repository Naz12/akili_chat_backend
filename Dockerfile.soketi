FROM node:18-slim

# Install git and other dependencies (required for npm install)
RUN apt-get update && \
    apt-get install -y git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Soketi globally
RUN npm install -g @soketi/soketi

EXPOSE 6001 9601

# Start Soketi - will use environment variables for app configuration
CMD ["soketi", "start", "--host", "0.0.0.0", "--port", "6001", "--debug"]

